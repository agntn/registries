{
  "name": "@agntn/registries",
  "version": "0.5.0",
  "description": "Universal package registry client. Query npm, PyPI, crates.io, RubyGems, Packagist and more with a single PURL-native API.",
  "keywords": [
    "crates",
    "mcp",
    "metadata",
    "npm",
    "package-registry",
    "packagist",
    "pi-extension",
    "purl",
    "pypi",
    "rubygems",
    "universal"
  ],
  "homepage": "https://github.com/agntn/registries#readme",
  "bugs": "https://github.com/agntn/registries/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/registries.git"
  },
  "bin": {
    "registries": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "extensions/pi",
    "extensions/omp"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ai": {
      "types": "./dist/ai.d.mts",
      "import": "./dist/ai.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    },
    "./tools": {
      "types": "./dist/tools.d.mts",
      "import": "./dist/tools.mjs"
    },
    "./registries": {
      "types": "./dist/registries/index.d.mts",
      "import": "./dist/registries/index.mjs"
    },
    "./registries/*": {
      "types": "./dist/registries/*.d.mts",
      "import": "./dist/registries/*.mjs"
    },
    "./cache": {
      "types": "./dist/cache/index.d.mts",
      "import": "./dist/cache/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev:prepare": "obuild --stub",
    "fmt": "pnpm lint:fix",
    "lint": "pnpm build && vp lint && vp fmt --check",
    "lint:fix": "vp lint --fix && vp fmt",
    "typecheck": "tsc --noEmit && pnpm build && tsc -p test/tsconfig.json --noEmit && tsc -p tsconfig.extensions.json --noEmit",
    "test": "vp test watch",
    "test:run": "vp test run",
    "prepack": "pnpm run build",
    "docs": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build"
  },
  "dependencies": {
    "@agntn/hashes": "catalog:deps",
    "@agntn/tools": "catalog:deps",
    "@modelcontextprotocol/server": "catalog:deps",
    "unstorage": "catalog:deps"
  },
  "devDependencies": {
    "@agntn/ox": "catalog:dev",
    "@earendil-works/pi-coding-agent": "catalog:dev",
    "@modelcontextprotocol/client": "catalog:dev",
    "@oh-my-pi/omptype": "catalog:dev",
    "@oh-my-pi/pi-coding-agent": "catalog:dev",
    "@types/node": "catalog:dev",
    "ai": "catalog:dev",
    "obuild": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev",
    "typebox": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2 <2",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19",
    "ai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0",
  "mcpServers": {
    "registries": {
      "command": "node",
      "args": [
        "dist/cli.mjs",
        "mcp"
      ]
    }
  },
  "omp": {
    "extensions": [
      "./extensions/omp/registries.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/pi/registries.ts"
    ]
  }
}
